# Конфиг gdlint (gdtoolkit 4.5) — используется локально и в CI-джобе FAST VALIDATION.
#
# Почему так:
#   max-line-length = 132: в проекте длинные сообщения и документация на русском;
#     дефолтные 100 заставили бы резать осмысленные строки «в никуда».
#   class-definitions-order: порядок const/var/signal задаётся связкой «константы
#     поведения рядом с полями, которые они описывают», а не каноническим
#     signals->enums->consts->vars. Это стиль, а не ошибка.
#   max-public-methods: MeshBuilder/WorldGenerator — намеренно «библиотеки чистых
#     функций»; дробить их на 6 классов ради лимита только хуже.
#   max-returns: функции проекта сознательно построены на ранних выходах (guard
#     clauses) вместо вложенных if; лимит в 6 наказывал бы за читаемость.
#   max-file-lines: tests/run_tests.gd — осознанно один файл-реестр: список тестов,
#     хелперы и отчёт держатся вместе, а «разбор» на 4 файла только усложнил бы чтение.
max-line-length: 132
max-file-lines: 1250
disable:
  - class-definitions-order
  - max-public-methods
  - max-returns
