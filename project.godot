; Engine configuration file.
; Police Chase: Open World — единый мобильный 3D-проект (Godot 4.7.2-stable, Android / arm64-v8a).
;
; RENDERER DECISION
;   Target device: Infinix HOT 40i (MediaTek Helio G85 + Mali-G52 MC1, Android 13).
;   This class of mobile GPU has a mature GLES 3.1 driver and no reliable production Vulkan
;   path, so `gl_compatibility` is selected for desktop AND mobile — it is also the
;   combination Godot recommends for low/mid-range Android hardware.
;   The `mobile` (Vulkan) renderer stays configurable: see docs/GRAPHICS_AND_PERF.md.
;
; TUNING POLICY
;   This file holds only engine/render/bootstrap settings. Every gameplay number lives in
;   res://autoloads/*.cfg (plain text, hot-reloadable, overridable with res://override_cfg/)
;   and is exposed to the editor through the custom Resource classes in res://scripts/config/.

config_version=5

[application]

config/name="Police Chase: Open World"
config/description="Симулятор угона от мусоров: открытый мир, процедурный город, дрифт, нитро. Сборка под портретный Android."
config/version="4.0.9 TEXT"
run/main_scene="res://scenes/menu/OrientationGate.tscn"
config/features=PackedStringArray("4.7", "GLES 3.1")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.055, 0.078, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

Config="*res://scripts/core/config.gd"
GameSetup="*res://scripts/core/game_setup.gd"
AppState="*res://scripts/core/app_state.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Settings="*res://scripts/core/settings_manager.gd"
ScreenFlow="*res://scripts/core/screen_flow.gd"
PerformanceManager="*res://scripts/core/performance_manager.gd"
DebugConsole="*res://scripts/debug/debug_console.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

