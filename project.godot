; Engine configuration file.
; Every setting in this file was validated against the Godot 4.7.2 source tree.
; It is best edited using the editor UI and not directly, since the parameters
; that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Симулятор угона от мусоров"
config/description="3D open-world mobile car chase. Target device: Infinix HOT 40i (Android 13, 720x1612, arm64-v8a, Mali-G52 class GPU)."
config/version="4.0.9"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"
config/use_custom_user_dir=false
boot_splash/bg_color=Color(0.0431373, 0.0509804, 0.0745098, 1)
boot_splash/show_image=false

[autoload]

SettingsManager="*res://scripts/core/settings_manager.gd"
InputManager="*res://scripts/core/input_manager.gd"
GameState="*res://scripts/core/game_state.gd"
PerformanceManager="*res://scripts/core/performance_manager.gd"
ScreenFlow="*res://scripts/core/screen_flow.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

physics/3d/physics_engine="Jolt Physics"
physics/common/physics_ticks_per_second=60
physics/common/max_physics_steps_per_frame=4
physics/3d/default_gravity=12.0
physics/3d/default_linear_damp=0.05
physics/3d/default_angular_damp=0.1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Required by the Android exporter in Godot 4.7.2: without ETC2/ASTC import the export
; fails with "ETC2/ASTC texture compression is required for Android export".
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=1
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/16_bits=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.47450981, 0.57647061, 0.68627453, 1)
occlusion_culling/use_occlusion_culling=false
limits/opengl/max_renderable_elements=131072
limits/opengl/max_renderable_lights=16
limits/opengl/max_lights_per_object=8

[input]

steer_left={
"deadzone": 0.2,
