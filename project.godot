[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="PlayerCar"
3d_physics/layer_3="PoliceCar"
3d_physics/layer_4="Prop"
3d_physics/layer_5="Trigger"

[physics]

3d/physics_engine="GodotPhysics"
3d/default_gravity=9.8
3d/default_linear_damp=0.0
3d/default_angular_damp=0.15
3d/sleep_threshold_linear=0.12
3d/time_before_sleep=0.6
3d/solver/solver_iterations=10
3d/solver/contact_max_separation=0.01
3d/solver/contact_recycle_radius=1.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/use_physical_light_units=false
occlusion_culling/use_occlusion_culling=true
occlusion_culling/occlusion_rays_per_thread=64
occlusion_culling/bvh_build_quality=0
textures/default_filters/anisotropic_filtering_level=0
textures/default_filters/texture_mipmap_bias=-0.4
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
mesh_lod/lod_change/threshold_pixels=1.2
environment/defaults/default_clear_color=Color(0.055, 0.066, 0.086, 1)
